#!/usr/bin/env bash
mkdir -p /var/log/libvirt
LOGFILE="/var/log/libvirt/vfio.log"
GPU_PCI="0000:0b:00.0"
GPU_AUDIO="0000:0b:00.1"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOGFILE"
}

bind_vfio() {
  for dev in "$@"; do
    if [ -e "/sys/bus/pci/devices/$dev/driver" ]; then
      echo "$dev" > "/sys/bus/pci/devices/$dev/driver/unbind" 2>/dev/null
    fi
    # DÜZELTME: aşağıdaki iki yazma 2>/dev/null ile yutuluyordu ve bind
    # başarısız olsa bile HİÇBİR iz bırakmıyordu. Kullanıcı ancak çok
    # sonra, prepare() sonundaki device_bound_to_vfio kontrolünde
    # "GPU bağlanamadı" görüyor ve NEDENini (IOMMU kapalı mı, override
    # mı takılı, kart başka sürücüde mi) öğrenemiyordu. Şimdi her iki
    # adım da loglanıyor; device_bound_to_vfio kontrolü YERİNDE kalıyor.
    echo "vfio-pci" > "/sys/bus/pci/devices/$dev/driver_override" 2>/dev/null ||
      log "UYARI: $dev icin driver_override yazilamadi (cihaz yok mu?)."
    if ! echo "$dev" > "/sys/bus/pci/drivers/vfio-pci/bind" 2>/dev/null; then
      log "UYARI: $dev -> vfio-pci bind basarisiz, drivers_probe deneniyor."
      echo "$dev" > /sys/bus/pci/drivers_probe 2>/dev/null ||
        log "  $dev -> drivers_probe de basarisiz. En olasi nedenler: BIOS'ta IOMMU/AMD-Vi kapali, ya da kart baska bir surucuye bagli ve IOMMU grubu tek basina degil."
    fi
  done
}

release_host_driver() {
  # GPU_PCI (fonksiyon .0) amdgpu'ya, GPU_AUDIO (fonksiyon .1) ise
  # normalde snd_hda_intel'e bağlanır — ikisi FARKLI sürücüler.
  # Önceki sürüm ikisini de zorla "amdgpu"ya bağlamaya çalışıyordu;
  # audio fonksiyonu amdgpu'nun ID tablosunda olmadığından bind
  # başarısız oluyor, driver_override "amdgpu" olarak takılı kalıyor
  # ve ses fonksiyonu sürücüsüz kalıyordu. Bunun yerine override'ı
  # temizleyip kernelin normal PCI ID eşleştirmesiyle (drivers_probe)
  # doğru sürücüyü kendisinin bulmasına izin veriyoruz.
  for dev in "$@"; do
    if [ -e "/sys/bus/pci/devices/$dev/driver" ]; then
      echo "$dev" > "/sys/bus/pci/devices/$dev/driver/unbind" 2>/dev/null
    fi
    echo "" > "/sys/bus/pci/devices/$dev/driver_override" 2>/dev/null
    echo "$dev" > /sys/bus/pci/drivers_probe 2>/dev/null
  done
}

# Cihaz gerçek (vfio-pci olmayan, boş olmayan) bir sürücüye bağlanmış mı?
device_has_real_driver() {
  local dev="$1" drv
  drv=$(basename "$(readlink -f "/sys/bus/pci/devices/$dev/driver" 2>/dev/null)" 2>/dev/null)
  [ -n "$drv" ] && [ "$drv" != "vfio-pci" ]
}

# TOPLULUK ÇÖZÜMÜ (fallback): RDNA1/RDNA2 (Navi 10-23, RX 6700 XT dahil)
# kartların bir kısmında düz unbind/rebind ("release_host_driver") host'a
# döndükten sonra GPU'yu canlandırmıyor. VFIO forumlarında en çok işe
# yarayan yöntem: cihazı PCI ağacından TAMAMEN kaldırıp (remove), host'u
# kısaca RAM'e uyutup (rtcwake ile kendiliğinden uyandırarak) sonra bus'ı
# yeniden taratmak (rescan). Bu, cihazı sanki yeni takılmış gibi sıfırdan
# enumerate ettirip normal sürücü eşleşmesini (amdgpu / snd_hda_intel)
# tetikliyor. Host'u kısaca uyuttuğu için görünür/rahatsız edici bir adım
# — bu yüzden SADECE sessiz unbind/rebind yetersiz kalırsa devreye giriyor.
suspend_rescan_recovery() {
  log "Sessiz unbind/rebind yetersiz kaldı, remove+suspend+rescan kurtarma deneniyor..."
  for dev in "$@"; do
    echo 1 > "/sys/bus/pci/devices/$dev/remove" 2>/dev/null || true
  done
  sleep 1
  # DÜZELTME (2026-10-05): askıya alma kalıcı bir kilitlenme riski taşır —
  # RTC alarmı BIOS'ta kapalıysa host bir daha kendiliğinden uyanmaz.
  # DÜZELTME (2026-10-09): bu uyarı daha önce /dev/tty1 ve /dev/tty2'ye
  # yazılıyordu, ancak vtcon'lar `prepare` aşamasında çözülmüş durumda
  # olduğu için mesaj GÖRÜNMEYEN konsollara düşüyordu. Askıya alma zaten
  # $LOGFILE'a rtcwake çıktısıyla kaydediliyor; log() yeterli.
  log "GPU kurtarma: host 3 sn askiya alinacak (bu bir hata degil)."
  if [ -x "${HOOK_RTCWAKE:-/run/current-system/sw/bin/rtcwake}" ]; then
    "${HOOK_RTCWAKE:-/run/current-system/sw/bin/rtcwake}" -m mem -s 3 >>"$LOGFILE" 2>&1 || \
      log "UYARI: rtcwake başarısız oldu (bkz. log), suspend adımı atlanmış olabilir."
  else
    log "UYARI: rtcwake bulunamadı (util-linux), suspend adımı atlandı — sadece rescan deneniyor."
  fi
  sleep 1
  echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
  sleep 2
}

# ÖNEMLİ SINIRLAMA: Bu fonksiyon "device_specific"/"reset" sysfs yollarını
# dener, ama bu GENEL bir reset denemesidir — gnif/vendor-reset kernel
# modülünün resmi olarak desteklediği "reset bug" listesi Polaris, Vega10,
# Vega20 ve Navi 10/12/14 (5000 serisi) ile sınırlıdır. Navi 21/22/23
# (RX 6000 serisi, bu depoda test edilen RX 6700 XT dahil) bu listede YOK.
# Yani bu kart bazı sistemlerde VM ikinci kez açılmaya çalışıldığında hâlâ
# "reset bug"a benzer şekilde takılabilir (ekran kararması / GPU'nun PCIe
# bus'tan tamamen düşmesi). "release" aşamasında bu durum artık
# suspend_rescan_recovery() fallback'iyle ayrıca ele alınıyor.
vendor_reset() {
  local dev="$1" ok=0
  if [ -e "/sys/bus/pci/devices/$dev/reset_method" ]; then
    echo "device_specific" > "/sys/bus/pci/devices/$dev/reset_method" 2>/dev/null && ok=1
  fi
  if [ -e "/sys/bus/pci/devices/$dev/reset" ]; then
    echo 1 > "/sys/bus/pci/devices/$dev/reset" 2>/dev/null && ok=1
  fi
  sleep 1
  # Reset sonrası cihaz hâlâ PCI config space üzerinden okunabiliyor mu?
  # Okunamıyorsa (kart bus'tan düştüyse) bunu en azından log'a yazalım.
  if ! "${HOOK_SETPCI:-/run/current-system/sw/bin/setpci}" -s "$dev" 0x0.w >/dev/null 2>&1; then
    log "UYARI: $dev reset sonrası yanıt vermiyor — GPU PCIe bus'tan düşmüş olabilir (bilinen Navi2x sınırlaması). Ekran geri gelmezse host reboot gerekebilir."
  elif [ "$ok" -eq 0 ]; then
    log "UYARI: $dev için reset_method/reset sysfs yolları bulunamadı, reset denenemedi."
  fi
}

# $GPU_PCI'nin hangi /dev/dri/cardN düğümüne karşılık geldiğini sistemden
# soruyoruz. Öncesinde "card0" sabit varsayılıyordu — iGPU eklenmesi ya da
# kart numaralandırmasının değişmesi durumunda stop_hyprland() yanlış
# cihazın kullanımda olup olmadığına bakabilirdi. Bu makinede (iGPU'suz
# Ryzen 5 5600 + tek RX 6700 XT) pratikte hep card0 çıkıyordu ama bu artık
# varsayıma değil, gerçek PCI eşleşmesine dayanıyor.
gpu_drm_card() {
  local dev="$1" node
  node=$(ls -d "/sys/bus/pci/devices/$dev/drm/card"* 2>/dev/null | head -n1)
  if [ -n "$node" ]; then
    basename "$node"
  else
    log "UYARI: $dev için /sys/.../drm/cardN bulunamadı, card0'a düşülüyor."
    echo "card0"
  fi
}

stop_hyprland() {
  log "Greetd durduruluyor..."
  systemctl stop greetd 2>/dev/null || true

  # Düzeltme (2026-10-04): hook yalnız greetd'i durduruyordu. Ollama ROCm
  # ile GPU'yu açık tutuyor; bu yüzden /dev/dri/card* 'de fuser çıkıyor,
  # 10 sn sonra döngü sessizce bitiyor ve aşağıdaki amdgpu unbind takılıyordu.
  # GPU'yu bırakması gereken tüm kullanıcı servisleri önce kapatılır.
  log "GPU kullanan servisler durduruluyor (ollama/polkit/...)..."
  for svc in ollama polkit.service; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      log "  durduruluyor: $svc"
      # DÜZELTME (2026-10-04): stop sessizce yutuluyordu; başarısızlık
      # ancak 20 sn sonra fuser zaman aşımı olarak ortaya çıkıyordu.
      if ! systemctl stop "$svc" 2>/dev/null; then
        log "  UYARI: $svc durdurulamadi — /dev/kfd hala acik olabilir."
      fi
    fi
  done
  # Kullanıcı seviyesindeki GPU tutucuları da kapat (hyprland, oyun vs.).
  # --all: oturum açık tüm oturumlar.
  log "Kullanıcı oturumları sonlandırılıyor..."
  loginctl terminate-user "${HOST_USER:-localhost}" 2>/dev/null || true
  loginctl terminate-seat seat0 2>/dev/null || true

  local card nodes
  card=$(gpu_drm_card "$GPU_PCI")
  # cardN yaninda renderD* de kontrol edilmeli: ROCm/Ollama yalnizca
  # render node'u acabiliyor, cardN bos gorunuyor.
  nodes=$(ls -d /sys/bus/pci/devices/"$GPU_PCI"/drm/renderD* 2>/dev/null |
         sed 's|.*/||' | sed 's|^|/dev/dri/|')
  nodes="/dev/dri/$card ${nodes:-}"
  # ROCm/compute süreçleri /dev/kfd'yi açık tutabilir; cardN ve renderD*
# boş görünse bile bu düğüm GPU'yu kilitler. Ollama stop edilse de
# başka bir ROCm süreci açık bırakmış olabilir.
[ -e /dev/kfd ] && nodes="$nodes /dev/kfd"
  # _unused: sayaç değeri kullanılmıyor, sadece kaç kez beklendiğini sayıyoruz.
  # Düzeltme: önceden sabit 20 döngü (10 sn) vardı, zaman aşımı başarısız
  # sayılmıyordu. Artık GERÇEK bir zaman aşımı var: 20 sn dolunca hata
  # döner, prepare() rollback'e düşer, masaüstü yanlışlıkla kapalı kalmaz.
  local waited=0
  for _unused in $(seq 1 40); do
    # shellcheck disable=SC2086
    if ! "${HOOK_FUSER:-/run/current-system/sw/bin/fuser}" $nodes >/dev/null 2>&1; then
      break
    fi
    sleep 0.5
    waited=$((waited + 1))
  done
  # shellcheck disable=SC2086
  if "${HOOK_FUSER:-/run/current-system/sw/bin/fuser}" $nodes >/dev/null 2>&1; then
    log "HATA: /dev/dri/$card hala kullanımda (~20 sn). GPU'ya baglanilamiyor."
    log "Sik kullanilanlar: ollama, gamescope, mpv, chromium, steam."
    log "ps aux | grep -E 'ollama|gamescope|mpv|chrom'  →  sadece o surecler"
    return 1
  fi
  log "GPU serbest ($nodes kontrol edildi, ${waited} yarim saniye bekledi)."
  sleep 1
}

start_hyprland() {
  log "Greetd başlatılıyor..."
  systemctl start greetd 2>/dev/null || true
  # Hook'un durdurduğu GPU servisleri geri aç (VM kapanınca).
  # DÜZELTME (2026-10-04): burada tek elemanlı bir servis döngüsü vardı ve
  # SC2043 (useless loop) uyarısı veriyordu; CI gate'i -S warning
  # olduğu için kırılıyordu. Tek servis olduğu için döngü tamamen kaldırıldı,
  # doğrudan if yazıldı. NOT: bu açıklamada "shellcheck" kelimesi satır
  # başına yazılmaz — yorum satırı "# shellcheck" ile başlarsa linter onu
  # directive sanıp SC1073 atar ve dosya parse edilemez. Yalnızca gerçek
  # yönlendirmeler (# shellcheck disable=SCxxxx biçiminde) bu öneki kullanır.
  # DÜZELTME (2026-10-05): stop_hyprland() hem "ollama" hem "polkit.service"
  # durduruyordu ama geri açılan TEK SERVİS ollama'ydı. polkit kalıcı olarak
  # kapalı kalıyor, yani VM sonrası yetkilendirme diyalogları (disk bağlama,
  # ağ değişikliği) hiç açılmıyordu.
  for svc in ollama polkit.service; do
    if systemctl is-enabled --quiet "$svc" 2>/dev/null; then
      if systemctl start "$svc" 2>/dev/null; then
        log "  $svc yeniden baslatildi."
      else
        log "  UYARI: $svc yeniden baslatilamadi."
      fi
    fi
  done
}

# Cihaz gerçekten vfio-pci'ye bağlanmış mı? (bind_vfio'nun sessizce
# yuttuğu hataları burada gerçek bir kontrolle yakalıyoruz.)
device_bound_to_vfio() {
  local dev="$1" drv
  drv=$(basename "$(readlink -f "/sys/bus/pci/devices/$dev/driver" 2>/dev/null)" 2>/dev/null)
  [ "$drv" = "vfio-pci" ]
}

# ROLLBACK: prepare aşamasında VFIO bind başarısız olursa, host'u yarım
# durumda (masaüstü kapalı, GPU ne host'ta ne guest'te) bırakmak yerine
# elden geldiğince eski haline döndürmeye çalışıyoruz.
rollback_prepare() {
  log "HATA: GPU vfio-pci'ye bağlanamadı, rollback deneniyor..."
  release_host_driver "$GPU_PCI" "$GPU_AUDIO"
  echo 1 > /sys/class/vtconsole/vtcon0/bind 2>/dev/null || true
  echo 1 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
  echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/bind 2>/dev/null || true
  start_hyprland
}

GUEST="$1"
ACTION="$2"
TARGET_VM="win10"

# Bu script libvirt tarafından TÜM VM'ler için çağrılır (sadece $TARGET_VM
# için değil). Filtre olmadan ileride eklenecek herhangi bir VM de host
# GPU'sunu vfio-pci'ye alıp masaüstünü kapatır.
if [ "$GUEST" != "$TARGET_VM" ]; then
  exit 0
fi

if [ "$ACTION" = "prepare" ]; then
  log "VM $GUEST başlatılıyor, masaüstü durduruluyor..."
  # Düzeltme (2026-10-04): stop_hyprland artık GPU serbest bırakılmazsa
  # 1 döndürüyor. Önceden dönüş değeri yok sayılıyordu ve script, GPU hâlâ
  # kullanımdayken vfio unbind'a gidiyordu → takılma + ortada kapalı masaüstü.
  if ! stop_hyprland; then
    rollback_prepare
    exit 1
  fi
  echo 0 > /sys/class/vtconsole/vtcon0/bind 2>/dev/null || true
  echo 0 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
  echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/unbind 2>/dev/null || true
  sleep 1
  # DÜZELTME (2026-10-05): sıra ters çevrildi. vfio-pci bind sırasında zaten
  # bir reset yapıyor; bind SONRASI yapılan ek FLR gereksiz ve Navi2x reset
  # bug'ının en çok konuşulan tetikleyicisiydi. Reset artık bind'den önce.
  vendor_reset "$GPU_PCI"
  bind_vfio "$GPU_PCI" "$GPU_AUDIO"

  # bind_vfio() içindeki hatalar sessizce yutuluyordu ve script bu durumda
  # bile "bağlandı" diye loglayıp devam ediyordu — halbuki host masaüstü
  # zaten kapatılmış oluyordu. Şimdi gerçekten vfio-pci'ye bağlanıp
  # bağlanmadığını kontrol ediyoruz; bağlanmadıysa rollback yapıp libvirt'e
  # (exit 1 ile) VM'i başlatmamasını söylüyoruz.
  if ! device_bound_to_vfio "$GPU_PCI" || ! device_bound_to_vfio "$GPU_AUDIO"; then
    rollback_prepare
    exit 1
  fi
  log "GPU vfio-pci'ye bağlandı."
fi

if [ "$ACTION" = "release" ]; then
  log "VM $GUEST kapandı, GPU geri alınıyor..."
  release_host_driver "$GPU_PCI" "$GPU_AUDIO"
  sleep 1

  # Sessiz unbind/rebind işe yaramadıysa (Navi2x reset bug ihtimali),
  # ağır ama daha güvenilir remove+suspend+rescan yöntemine düş.
  if ! device_has_real_driver "$GPU_PCI" || ! device_has_real_driver "$GPU_AUDIO"; then
    suspend_rescan_recovery "$GPU_AUDIO" "$GPU_PCI"
    if ! device_has_real_driver "$GPU_PCI"; then
      log "UYARI: $GPU_PCI kurtarma sonrası da normal sürücüye bağlanmadı — GPU muhtemelen PCIe bus'tan düştü, host reboot gerekebilir."
    fi
    # Önceden sadece GPU (.0) tekrar kontrol ediliyordu; audio (.1)
    # fonksiyonu kurtarma sonrası sürücüsüz kalsa bile bu fark edilmiyordu.
    if ! device_has_real_driver "$GPU_AUDIO"; then
      log "UYARI: $GPU_AUDIO (ses fonksiyonu) kurtarma sonrası da normal sürücüye bağlanmadı."
    fi
  fi

  # DÜZELTME (2026-10-09): metin KONSOLLARININ GERİ BAĞLANMASI buraya taşındı.
  # Önceden bu üç satır `start_hyprland`'dan hemen önce, yani aşağıdaki kritik
  # uyarı YAZILDIKTAN SONRA çalışıyordu. O sırada vtcon0/vtcon1 hâlâ `prepare`
  # aşamasında çözülmüş durumda olduğundan "GPU sürücüsü yok, siyah ekran normal,
  # şunu yap" mesajı GÖRÜNMEYEN konsollara yazılıyordu — yani tam olarak o
  # mesajın var olma sebebi olan kullanıcıya hiç ulaşmıyordu.
  #
  # Sıralamanın etkisi: greetd'den ÖNCE çalışır ama greetd'ye dokunmaz; sadece
  # metin konsolları (vt1/vt2) ve efi-framebuffer geri gelir. GPU hâlâ sürücüsüzse
  # grafik oturum yine açılmaz, ama bu noktada kullanıcı artık konsolda ne
  # yapması gerektiğini okuyabilir.
  echo 1 > /sys/class/vtconsole/vtcon0/bind 2>/dev/null || true
  echo 1 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
  echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/bind 2>/dev/null || true
  sleep 1

  # DÜZELTME: GPU kurtarma sonrası hâlâ sürücüsüzse (Navi2x reset bug) bu
  # satırlar yalnızca bir "UYARI" loglayıp masaüstünü açıyordu -> kullanıcı
  # siyah ekrana bakar ve ne yapacağını bilemiyordu. Artık durum tty1'e de
  # yazılıyor ve ne yapılması gerektiği açıkça söyleniyor.
  if ! device_has_real_driver "$GPU_PCI"; then
    log "KRİTİK: $GPU_PCI hâlâ sürücüsüz. Ekranda GÖRÜNTÜ YOKTUR (bu normal:"
    log "Navi2x reset bug). Kurtarma için açılışta BOOT MENÜSÜ'ne gir veya"
    log "konsola geç (Ctrl+Alt+F2) ve 'systemctl reboot' çalıştır."
    log "Önce kurtarma denemeleri: 'sudo modprobe -r amdgpu && sudo modprobe amdgpu'"
    for tty in /dev/tty1 /dev/tty2; do
      [ -w "$tty" ] && printf '%s\n' "GPU sürücüsü yok - siyah ekran normal. Kurtarma: systemctl reboot" > "$tty" 2>/dev/null || true
    done
  else
    log "GPU host'a geri verildi, masaüstü başlatılıyor."
  fi

  # NOT: vtcon/efifb rebind artık yukarıda, kritik uyarıdan ÖNCE yapılıyor
  # (DÜZELTME 2026-10-09). Burada tekrarı gereksiz.
  # NOT: burada bilinçli olarak exit 1 YOK. start_hyprland'ı atlamak greetd'yi
  # kapalı bırakır ve kullanıcının grafik oturumu açma şansını da keser; oysa
  # metot zaten denendi ve GPU sürücüsüz. Doğru davranış: yönlendirme mesajını
  # olabildiğince görünür kılmak, yoksa sistemi yarı açık bırakmamak.
  start_hyprland
fi
