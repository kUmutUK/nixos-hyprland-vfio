#!/usr/bin/env bash
mkdir -p /var/log/libvirt
LOGFILE="/var/log/libvirt/vfio.log"
GPU_PCI="0000:0b:00.0"
GPU_AUDIO="0000:0b:00.1"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOGFILE"
}

bind_vfio() {
  for dev in "$@"; do
    # Mark the device as touched before unbind/bind. If a signal arrives mid-operation,
    # rollback checks the live sysfs state before deciding what to restore.
    case "$dev" in
      "$GPU_PCI") PREPARE_GPU_PCI_TOUCHED=1 ;;
      "$GPU_AUDIO") PREPARE_GPU_AUDIO_TOUCHED=1 ;;
    esac
    if [ -e "/sys/bus/pci/devices/$dev/driver" ]; then
      echo "$dev" > "/sys/bus/pci/devices/$dev/driver/unbind" 2>/dev/null
    fi
    # Previously, write errors were hidden by `2>/dev/null`, making a failed bind hard
    # to diagnose until the final validation. Log the override and bind failures while
    # keeping the `device_bound_to_vfio` verification in place.
    echo "vfio-pci" > "/sys/bus/pci/devices/$dev/driver_override" 2>/dev/null ||
      log "WARNING: Could not write driver_override for $dev (does the device exist?)."
    if ! echo "$dev" > "/sys/bus/pci/drivers/vfio-pci/bind" 2>/dev/null; then
      log "WARNING: Binding $dev to vfio-pci failed; trying drivers_probe."
      echo "$dev" > /sys/bus/pci/drivers_probe 2>/dev/null ||
        log "  drivers_probe also failed for $dev. Possible causes: IOMMU/AMD-Vi is disabled in BIOS/UEFI, or the device remains bound to another driver; an IOMMU group alone is not sufficient."
    fi
  done
}

release_host_driver() {
  # The GPU function (.0) normally uses `amdgpu`; the HDMI/DisplayPort audio function
  # (.1) normally uses `snd_hda_intel`. Do not force both to `amdgpu`: clear the override
  # and let the kernel's PCI ID matching (`drivers_probe`) select the correct driver.
  for dev in "$@"; do
    if [ -e "/sys/bus/pci/devices/$dev/driver" ]; then
      echo "$dev" > "/sys/bus/pci/devices/$dev/driver/unbind" 2>/dev/null
    fi
    echo "" > "/sys/bus/pci/devices/$dev/driver_override" 2>/dev/null
    echo "$dev" > /sys/bus/pci/drivers_probe 2>/dev/null
  done
}

# Resolve the actual bound PCI driver. `readlink -f` may normalize a missing final
# component to a path named `driver`; `-L` and `readlink -e` require a real, resolvable
# symlink.
device_driver_name() {
  local dev="$1" devices_root="${2:-/sys/bus/pci/devices}" driver_link resolved
  driver_link="${devices_root}/${dev}/driver"
  [ -L "$driver_link" ] || return 1
  resolved="$(readlink -e -- "$driver_link" 2>/dev/null)" || return 1
  printf '%s\n' "${resolved##*/}"
}

# Return true only when a real, non-empty driver other than `vfio-pci` is bound.
device_has_real_driver() {
  local drv
  drv="$(device_driver_name "$1" "${2:-/sys/bus/pci/devices}")" || return 1
  [ "$drv" != "vfio-pci" ]
}

# Recovery fallback for some RDNA1/RDNA2 cards (Navi 10–23, including RX 6700 XT):
# plain unbind/rebind may not restore the GPU. The fallback removes the device from the
# PCI tree, briefly suspends/wakes the host using `rtcwake`, then rescans the bus so the
# normal drivers can bind. This is disruptive and runs only when enabled explicitly and
# normal recovery has failed.
suspend_rescan_recovery() {
  # This fallback removes PCI devices and suspends the host; it is disabled by default.
  if [ "${VFIO_ALLOW_SUSPEND_RECOVERY:-0}" != "1" ]; then
    log "Suspend/remove/rescan fallback is DISABLED (VFIO_ALLOW_SUSPEND_RECOVERY=0)."
    log "If the GPU does not return, try manual recovery: sudo modprobe -r amdgpu && sudo modprobe amdgpu"
    log "If that does not work, reboot the host (sudo reboot)."
    return 1
  fi
  log "Suspend/remove/rescan recovery is enabled; normal unbind/rebind was insufficient..."
  for dev in "$@"; do
    echo 1 > "/sys/bus/pci/devices/$dev/remove" 2>/dev/null || true
  done
  sleep 1
  # The suspend fallback can leave the host asleep if firmware does not support RTC wake.
  # `rtcwake` output is logged to `$LOGFILE`; logging to `/dev/tty1`/`tty2` during prepare
  # was ineffective because those consoles had already been detached.
  log "GPU recovery: suspending the host for 3 seconds (this is expected)."
  if [ -x "${HOOK_RTCWAKE:-/run/current-system/sw/bin/rtcwake}" ]; then
    "${HOOK_RTCWAKE:-/run/current-system/sw/bin/rtcwake}" -m mem -s 3 >>"$LOGFILE" 2>&1 || \
      log "WARNING: rtcwake failed (see log); the suspend step may have been skipped."
  else
    log "WARNING: rtcwake was not found (util-linux); skipping suspend and trying only the PCI rescan."
  fi
  sleep 1
  echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
  sleep 2
}

# Limitation: this generic sysfs reset attempt is not equivalent to vendor-reset support.
# The commonly documented reset-bug list covers Polaris, Vega10/20, and Navi 10/12/14;
# Navi 21/22/23 (RX 6000, including RX 6700 XT) may still fail on a second VM start.
# The release path also has an opt-in suspend/remove/rescan fallback.
vendor_reset() {
  local dev="$1" ok=0
  if [ -e "/sys/bus/pci/devices/$dev/reset_method" ]; then
    echo "device_specific" > "/sys/bus/pci/devices/$dev/reset_method" 2>/dev/null && ok=1
  fi
  if [ -e "/sys/bus/pci/devices/$dev/reset" ]; then
    echo 1 > "/sys/bus/pci/devices/$dev/reset" 2>/dev/null && ok=1
  fi
  sleep 1
  # After reset, check whether the device is still readable through PCI configuration
  # space. Log a warning if it has disappeared from the bus.
  if ! "${HOOK_SETPCI:-/run/current-system/sw/bin/setpci}" -s "$dev" 0x0.w >/dev/null 2>&1; then
    log "WARNING: $dev is unresponsive after reset; the GPU may have disappeared from the PCIe bus (known Navi 2x limitation). A host reboot may be required if the display does not return."
  elif [ "$ok" -eq 0 ]; then
    log "WARNING: reset_method/reset sysfs paths were not found for $dev; reset could not be attempted."
  fi
}

# Map `$GPU_PCI` to its actual `/dev/dri/cardN` node. Never fall back to card0: on a
# multi-GPU host that would fail open and might inspect the wrong device. If there is no
# match, stop and let `rollback_prepare()` restore the host.
gpu_drm_card() {
  local dev="$1" candidate node=""
  for candidate in "/sys/bus/pci/devices/$dev/drm"/card[0-9]*; do
    [ -e "$candidate" ] || continue
    case "${candidate##*/}" in
      card[0-9]*)
        # Connector entries (card0-DP-1, etc.) must not be treated as cardN.
        [[ "${candidate##*/}" =~ ^card[0-9]+$ ]] || continue
        node="$candidate"
        break
        ;;
    esac
  done
  if [ -n "$node" ]; then
    printf '%s\n' "${node##*/}"
    return 0
  fi
  log "ERROR: Could not find the actual /sys/.../drm/cardN mapping for $dev; aborting GPU handoff."
  return 1
}

stop_hyprland() {
  local fuser_cmd="${HOOK_FUSER:-/run/current-system/sw/bin/fuser}"
  local node
  local -a node_list

  # If `fuser` is missing or fails (for example, exit 127), do not assume that the GPU is
  # idle. Fail closed before stopping the desktop or unbinding the host driver.
  if [ ! -x "$fuser_cmd" ]; then
    log "ERROR: Cannot execute fuser: $fuser_cmd; GPU handoff is aborted."
    return 1
  fi

  # After `fuser` is verified, services may be partially stopped. If a later operation
  # fails, rollback reverses only this preparation stage.
  PREPARE_DESKTOP_TOUCHED=1
  log "Stopping greetd..."
  systemctl stop greetd 2>/dev/null || true

  # The hook previously stopped only greetd. Ollama/ROCm could keep `/dev/dri/card*` in use,
  # so the wait timed out and the following `amdgpu` unbind could hang. Stop all user
  # services that may retain the GPU before attempting unbind.
  log "Stopping services that may use the GPU (ollama/polkit/...)..."
  for svc in ollama polkit.service; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      log "  stopping: $svc"
      # Do not hide a failed service stop; otherwise it appears later as an opaque `fuser`
      # timeout.
      if ! systemctl stop "$svc" 2>/dev/null; then
        log "  WARNING: Could not stop $svc; /dev/kfd may still be open."
      fi
    fi
  done
  # Also stop user-level processes holding the GPU, such as Hyprland and games.
  # `--all` targets every logged-in session.
  log "Terminating user sessions..."
  loginctl terminate-user "${HOST_USER:-localhost}" 2>/dev/null || true
  # `terminate-user` may terminate every session for `HOST_USER`, including SSH sessions.
  # `terminate-seat` targets seat0 and may close local VT/greeter sessions but does not
  # necessarily terminate a headless SSH session. Start the VM in a detached systemd-run
  # unit so the `virsh` client does not need to survive session termination.
  loginctl terminate-seat seat0 2>/dev/null || true

  local card nodes
  if ! card="$(gpu_drm_card "$GPU_PCI")"; then
    log "ERROR: GPU DRM mapping could not be verified; stop_hyprland failed and rollback is required."
    return 1
  fi
  # cardN yaninda renderD* de kontrol edilmeli: ROCm/Ollama yalnizca
  # render node'u acabiliyor, cardN bos gorunuyor.
  nodes=$(ls -d /sys/bus/pci/devices/"$GPU_PCI"/drm/renderD* 2>/dev/null |
         sed 's|.*/||' | sed 's|^|/dev/dri/|')
  nodes="/dev/dri/$card ${nodes:-}"
  # ROCm/compute processes may keep `/dev/kfd` open even when card/render nodes look idle.
  # Stopping Ollama does not guarantee that another ROCm process has released the GPU.
  [ -e /dev/kfd ] && nodes="$nodes /dev/kfd"
  read -r -a node_list <<< "$nodes"
  for node in "${node_list[@]}"; do
    if [ ! -e "$node" ]; then
      log "ERROR: GPU device node not found: $node; GPU handoff is aborted."
      return 1
    fi
  done

  # `fuser` exit 0 means a process is using the device. A non-zero exit may mean idle or
  # an error; if stderr is present, treat the state as unknown and roll back.
  gpu_nodes_in_use() {
    local fuser_diagnostic fuser_exit
    fuser_diagnostic=$("$fuser_cmd" "${node_list[@]}" 2>&1 >/dev/null)
    fuser_exit=$?
    if [ "$fuser_exit" -eq 0 ]; then
      return 0
    fi
    if [ -n "$fuser_diagnostic" ]; then
      log "ERROR: fuser returned diagnostics (exit $fuser_exit); the GPU will not be assumed idle."
      return 2
    fi
    return 1
  }

  # A timeout is not evidence that the GPU is idle. Treat timeouts and check errors as
  # failures and run rollback.
  local waited=0 _rc
  for _unused in $(seq 1 40); do
    if gpu_nodes_in_use; then
      sleep 0.5
      waited=$((waited + 1))
    else
      _rc=$?
      if [ "$_rc" -eq 1 ]; then
        break
      fi
      return 1
    fi
  done
  if gpu_nodes_in_use; then
    log "ERROR: GPU is still in use after about 20 seconds; it cannot be handed off."
    log "Common GPU users: ollama, gamescope, mpv, chromium, steam."
    log "Inspect likely GPU users with: ps aux | grep -E 'ollama|gamescope|mpv|chrom'"
    return 1
  else
    _rc=$?
    if [ "$_rc" -ne 1 ]; then
      return 1
    fi
  fi
  log "GPU is idle ($nodes checked; waited ${waited} half-second intervals)."
  sleep 1
}

start_hyprland() {
  log "Starting greetd..."
  systemctl start greetd 2>/dev/null || true
  # Restart the GPU-related services stopped by this hook when the VM exits. The old
  # one-item loop triggered ShellCheck SC2043 and has been replaced with a direct condition.
  # Only genuine `# shellcheck disable=...` directives should use the directive prefix.
  # Also restore both `ollama` and `polkit.service`; otherwise authorization dialogs could
  # remain unavailable after VM shutdown.
  for svc in ollama polkit.service; do
    if systemctl is-enabled --quiet "$svc" 2>/dev/null; then
      if systemctl start "$svc" 2>/dev/null; then
        log "  restarted $svc."
      else
        log "  WARNING: Could not restart $svc."
      fi
    fi
  done
}

# Verify that the device is actually bound to `vfio-pci`; this catches errors that
# `bind_vfio()` might otherwise leave hidden.
device_bound_to_vfio() {
  local drv
  drv="$(device_driver_name "$1" "${2:-/sys/bus/pci/devices}")" || return 1
  [ "$drv" = "vfio-pci" ]
}

# During rollback, repair only devices touched by VFIO preparation. If a host driver is
# still bound, do not unbind it; `bind_vfio` may have failed before changing drivers.
# Clear only the override in that case.
restore_prepare_device() {
  local dev="$1" touched="$2" devices_root="${3:-/sys/bus/pci/devices}" drv
  [ "$touched" = "1" ] || return 0

  if drv="$(device_driver_name "$dev" "$devices_root")" && [ "$drv" != "vfio-pci" ]; then
    log "Rollback: $dev is still bound to driver $drv; the driver will not be unbound."
    echo "" > "${devices_root}/${dev}/driver_override" 2>/dev/null || true
  else
    # A missing or unresolved driver symlink means no driver is bound. Try probing the host
    # driver again, but never treat `vfio-pci` as the host driver.
    log "Rollback: $dev has no driver or is bound to vfio-pci; restoring the host driver."
    release_host_driver "$dev"
  fi
}

# Rollback restores only state changed by `prepare`. If `stop_hyprland` fails early,
# the GPU driver should not have been changed.
rollback_prepare() {
  # Prevent a signal during rollback from starting nested recovery operations.
  trap - HUP INT TERM
  log "ERROR: prepare failed; attempting rollback based on the current device state..."

  restore_prepare_device "$GPU_PCI" "$PREPARE_GPU_PCI_TOUCHED"
  restore_prepare_device "$GPU_AUDIO" "$PREPARE_GPU_AUDIO_TOUCHED"

  if [ "$PREPARE_DISPLAY_DETACH_ATTEMPTED" -eq 1 ]; then
    echo 1 > /sys/class/vtconsole/vtcon0/bind 2>/dev/null || true
    echo 1 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
    echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/bind 2>/dev/null || true
  fi

  if [ "$PREPARE_DESKTOP_TOUCHED" -eq 1 ]; then
    start_hyprland
  fi
}

GUEST="$1"
ACTION="$2"
TARGET_VM="win10"

# These flags record state for the current `prepare` process; every hook invocation
# runs in a separate process.
PREPARE_DESKTOP_TOUCHED=0
PREPARE_DISPLAY_DETACH_ATTEMPTED=0
PREPARE_GPU_PCI_TOUCHED=0
PREPARE_GPU_AUDIO_TOUCHED=0

# libvirt invokes this hook for every VM, not only `$TARGET_VM`. Without filtering,
# any future guest could bind the host GPU to `vfio-pci` and stop the desktop.
if [ "$GUEST" != "$TARGET_VM" ]; then
  exit 0
fi

if [ "$ACTION" = "prepare" ]; then
  log "Starting VM $GUEST; stopping the desktop..."
  # If TERM/INT/HUP arrives during prepare, attempt to restore the host driver and desktop.
  # SIGKILL, power loss, and kernel lockups cannot be trapped.
  handle_prepare_signal() {
    local signal_name="$1" exit_status="$2"
    trap - HUP INT TERM
    log "ERROR: Received SIG${signal_name} during prepare; running rollback."
    rollback_prepare
    exit "$exit_status"
  }
  trap 'handle_prepare_signal HUP 129' HUP
  trap 'handle_prepare_signal INT 130' INT
  trap 'handle_prepare_signal TERM 143' TERM
  # Since `stop_hyprland` returns failure when it cannot release the GPU, do not ignore
  # its status and unbind a busy device. That previously left the desktop stopped and the
  # host stuck.
  if ! stop_hyprland; then
    rollback_prepare
    exit 1
  fi
  PREPARE_DISPLAY_DETACH_ATTEMPTED=1
  echo 0 > /sys/class/vtconsole/vtcon0/bind 2>/dev/null || true
  echo 0 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
  echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/unbind 2>/dev/null || true
  sleep 1
  # Before resetting the GPU (C2, 2026-10-09), detach its current PCI driver, especially
  # `amdgpu`. `bind_vfio()` then binds `vfio-pci`; the state flag lets rollback restore the
  # host driver if a signal arrives mid-operation.
  PREPARE_GPU_PCI_TOUCHED=1
  if [ -e "/sys/bus/pci/devices/$GPU_PCI/driver" ]; then
    if ! echo "$GPU_PCI" > "/sys/bus/pci/devices/$GPU_PCI/driver/unbind" 2>/dev/null; then
      log "ERROR: Could not unbind $GPU_PCI from its current driver; skipping reset."
      rollback_prepare
      exit 1
    fi
  fi
  if [ -e "/sys/bus/pci/devices/$GPU_PCI/driver" ]; then
    log "ERROR: $GPU_PCI is still bound to a driver after unbind; skipping reset."
    rollback_prepare
    exit 1
  fi
  vendor_reset "$GPU_PCI"
  bind_vfio "$GPU_PCI" "$GPU_AUDIO"

  # Previously, `bind_vfio()` errors were ignored and the hook logged success even when
  # the host desktop had stopped but VFIO binding failed. Verify the actual driver now;
  # otherwise roll back and return exit 1 so libvirt does not start the guest.
  if ! device_bound_to_vfio "$GPU_PCI" || ! device_bound_to_vfio "$GPU_AUDIO"; then
    rollback_prepare
    exit 1
  fi
  log "GPU is bound to vfio-pci."
  # Preparation succeeded; disable the rollback traps.
  trap - HUP INT TERM
fi

if [ "$ACTION" = "release" ]; then
  log "VM $GUEST stopped; restoring the GPU to the host..."
  release_host_driver "$GPU_PCI" "$GPU_AUDIO"
  sleep 1

  # If ordinary unbind/rebind fails (possible Navi 2x reset issue), use the heavier
  # remove/suspend/rescan method only when the explicit opt-in is enabled.
  if ! device_has_real_driver "$GPU_PCI" || ! device_has_real_driver "$GPU_AUDIO"; then
    suspend_rescan_recovery "$GPU_AUDIO" "$GPU_PCI"
    if ! device_has_real_driver "$GPU_PCI"; then
      log "WARNING: $GPU_PCI did not bind to its normal driver; recovery fallback may be disabled or rebinding may have failed. Host recovery may be required."
    fi
    # Re-check both the GPU (.0) and audio (.1) functions after recovery; checking only the
    # GPU previously missed an audio function left without a driver.
    if ! device_has_real_driver "$GPU_AUDIO"; then
      log "WARNING: $GPU_AUDIO (audio function) did not bind to its normal driver; recovery fallback may be disabled or rebinding may have failed."
    fi
  fi

  # Restore text consoles before printing the critical recovery warning. Previously the
  # instructions were written while vtcon0/vtcon1 were still detached, so the user could
  # not see them. This ordering restores VT1/VT2 and the EFI framebuffer before greetd;
  # it does not start greetd itself.
  echo 1 > /sys/class/vtconsole/vtcon0/bind 2>/dev/null || true
  echo 1 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
  echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/bind 2>/dev/null || true
  sleep 1

  # If the GPU still has no host driver after recovery, show the warning and actionable
  # reboot instructions on tty1 rather than only writing a log entry and leaving the user
  # with a black screen.
  if ! device_has_real_driver "$GPU_PCI"; then
    log "CRITICAL: $GPU_PCI still has no driver. THE DISPLAY WILL BE BLACK (this is expected with the known"
    log "Navi 2x reset issue). For recovery, enter the BOOT MENU during startup or"
    log "switch to a console (Ctrl+Alt+F2) and run 'systemctl reboot'."
    log "First try reloading the driver: 'sudo modprobe -r amdgpu && sudo modprobe amdgpu'."
    for tty in /dev/tty1 /dev/tty2; do
      [ -w "$tty" ] && printf '%s\n' "No GPU driver is bound; a black screen is expected. Recovery: systemctl reboot" > "$tty" 2>/dev/null || true
    done
  else
    log "GPU restored to the host; starting the desktop."
  fi

  # The text console/framebuffer rebind already runs above the warning. Do not exit 1 here:
  # that could leave greetd stopped and remove the user's graphical-login recovery path.
  # Keep the recovery instructions visible even if the GPU remains unavailable.
  start_hyprland
fi
