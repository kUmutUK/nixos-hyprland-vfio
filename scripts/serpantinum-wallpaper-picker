#!/usr/bin/env bash
# Open Serpantinum's static wallpaper picker without leaving mpvpaper above it.
# The optional live video wallpaper is stopped only for the current graphical
# session; graphical-session.target starts it again on the next login.
set -Eeuo pipefail

if systemctl --user is-active --quiet mpvpaper.service 2>/dev/null \
  || systemctl --user is-active --quiet mpvpaper-watchdog.service 2>/dev/null; then
  systemctl --user stop mpvpaper-watchdog.service mpvpaper.service || true
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 5000 "Wallpaper picker" \
      "Paused the live video wallpaper for this session so the static wallpaper picker can be used. It returns on next login." \
      || true
  fi
fi

exec serpantinum msg toggle wallpaper
